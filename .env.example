# Porta de execução da aplicação (Padrão: 3000)
PORT=3000

# Ambiente (production ou development)
NODE_ENV=production

# Diretório para armazenamento persistente do banco SQLite
DATA_DIR=/app/data

# GEMINI_API_KEY: Opcional, para recursos de inteligência artificial (Insights & Análise Financeira)
GEMINI_API_KEY=

# APP_URL: URL pública da aplicação configurada no EasyPanel (ex: https://money.seudominio.com)
APP_URL=

